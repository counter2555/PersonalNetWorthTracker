# Copy to .env and adjust. Never commit .env.

# First administrator, created on the first start (afterwards accounts are managed in the app).
# Further users register themselves (admins can close the registration) or are created by an admin.
NWT_USERNAME=admin
# Password hash from `docker compose run --rm networth networth hash-password`.
# Double every $ in this file ($$), docker compose would read it as a variable otherwise.
NWT_PASSWORD_HASH=
# Alternatively a plain password (only if no hash is set):
# NWT_PASSWORD=change-me

# Set to true when the service is only reachable via HTTPS (reverse proxy): cookie is sent over HTTPS only
NWT_SECURE_COOKIES=false
# Days until a login expires
NWT_SESSION_DAYS=30
# Only behind a reverse proxy that does its own authentication (everyone acts as NWT_USERNAME):
# NWT_AUTH_DISABLED=true

# Served under a sub path of the reverse proxy, e.g. https://home.example/networth
# NWT_ROOT_PATH=/networth
# Proxy IPs whose X-Forwarded-* headers are trusted
# FORWARDED_ALLOW_IPS=*

# Host side (docker compose)
NWT_PORT=8000
NWT_HOST_DATA_DIR=./data
PUID=1000
PGID=1000

# Image to run; on the server the one pushed by build.sh
# NWT_IMAGE=homeserver.lan:5000/networth:latest
